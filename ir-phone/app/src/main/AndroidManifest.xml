<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.TRANSMIT_IR" />
    <uses-feature android:name="android.hardware.consumerir" android:required="true" />

    <application android:label="IR wake" android:allowBackup="false">
        <!-- Opened once so Android un-stops the package; after that the receiver is reached by adb. -->
        <activity android:name=".MainActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- Reached by adb: am broadcast with the extras carrier (Hz) and pattern (microseconds). -->
        <receiver android:name=".IrReceiver" android:exported="true" />
    </application>
</manifest>
