# Copy to .env and fill in. Never commit .env.

# Secret the mobile app sends as "Authorization: Bearer <token>" (min 16 chars).
# Generate one:  openssl rand -hex 24
API_TOKEN=

PORT=3100
# 127.0.0.1: only this Mac. 0.0.0.0 opens the app to the local network (use HTTPS or a VPN for the Mi Home password).
HOST=127.0.0.1

# go2rtc (keep it bound to 127.0.0.1 - only this backend talks to it)
GO2RTC_URL=http://127.0.0.1:1984
STREAM_NAME=psytonik_base

# Where snapshots are stored
DATA_DIR=./data

# Motion recording (needs ffmpeg in PATH and go2rtc's RTSP output)
MOTION_ENABLED=true
# Percent of the frame that must change to count as motion. Higher = less sensitive.
MOTION_THRESHOLD=1.2
RETENTION_DAYS=7
# MAX_STORAGE_GB=20
# MOTION_LIGHT_CHANGE=60
# MOTION_STALL_SEC=15
# Keep the camera's sound in the clips (false = silent clips). Recording sound is regulated in some places: tell people in the house.
# MOTION_AUDIO=true

# Object detection (./camera.sh fetch-model downloads the model)
# DETECT_ENABLED=true
# DETECT_MIN_SCORE=40
# false = keep clips in which nothing was recognised
# DETECT_DISCARD_EMPTY=true

# Push notifications
# PUSH_MIN_INTERVAL_SEC=120
# EXPO_ACCESS_TOKEN=

# Wrong-token lockout
# AUTH_MAX_FAILURES=10
# AUTH_WINDOW_SEC=60
# RTSP_URL=rtsp://127.0.0.1:8554/psytonik_base
# FFMPEG_PATH=/opt/homebrew/bin/ffmpeg

# CozyLife light strip on the local network (leave empty to hide the lamp controls).
# Give the lamp a fixed address in your router (DHCP reservation) so this doesn't change.
# LIGHT_IP=10.0.0.1
# LIGHT_PORT=5555

# Robot vacuum (Dreame, local miio protocol). The token comes from your Xiaomi account
# (Xiaomi-cloud-tokens-extractor); keep it only here, never in chat or git.
# VACUUM_IP=10.0.0.7
# VACUUM_TOKEN=
# How often (in ms) the server looks at the robot to send pushes: cleaning done, trouble, worn parts. 0 turns it off.
# VACUUM_WATCH_MS=60000

# Google TV / Android TV (TCL and others) as a remote control on the local network. Give the TV a fixed address in your router.
# Pair once from the TV page of the web app: the TV shows a six-character code, you type it there.
# TV_IP=10.0.0.9
# The TV's own "Source Choice" menu, and picking Home / TV / HDMI 1 / HDMI 2 / AV directly, go over ADB (a TCL ignores them on the
# remote protocol). On the TV: Settings > Device Preferences > About > tap Build 7 times, then Developer options > network debugging;
# accept the prompt for this computer once. Needs `adb` installed (brew install android-platform-tools); TV_ADB_PATH points to it if
# it is somewhere unusual. This gives this computer full control of the TV on the home network: leave it unset if you don't want that.
# TV_ADB=10.0.0.9:5555
# A sleeping TV has no network link, so no remote protocol reaches it. With its hardware address(es) the Power button (and the voice
# command) send a wake-up packet (Wake-on-LAN) instead when the TV does not answer. Wi-Fi and cable addresses, comma separated; find the
# Wi-Fi one with `arp -a` while the TV is on. Whether a TV wakes this way depends on the model and its network-standby setting.
# TV_MAC=d0:76:02:eb:6c:b9,38:26:56:56:2d:a6

# Voice assistant (the microphone button in the web app).
# Default: a free model on this computer through Ollama (brew install ollama; ollama pull qwen3:8b). Nothing leaves the house except the browser's speech recognition.
# ASSISTANT_PROVIDER=ollama
# ASSISTANT_MODEL=qwen3:8b
# OLLAMA_URL=http://127.0.0.1:11434
# Or Claude: with ANTHROPIC_API_KEY set, the provider is anthropic (spoken phrases are sent to Anthropic as text), model claude-opus-5-5.
# ANTHROPIC_API_KEY=

# The assistant's voice: Piper, a free neural voice on this computer (the page uses the browser's voices without it).
# Set up once (see docs/assistant.md): python3.12 -m venv venv-piper && venv-piper/bin/pip install piper-tts flask, then put the voice
# (ru_RU-denis-medium.onnx and .onnx.json) into backend/models/piper/. The backend starts and stops the Piper server itself.
# TTS_PIPER=false
# PIPER_PYTHON=../venv-piper/bin/python
# PIPER_MODEL=./models/piper/ru_RU-denis-medium.onnx
# PIPER_PORT=5055
