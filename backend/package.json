{
  "name": "xiaomi-camera-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "build": "tsc",
    "start": "node --env-file=.env dist/server.js",
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "label": "tsx --env-file=.env src/label.ts",
    "journal": "tsx --env-file=.env src/journalReport.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@fastify/helmet": "^13.2.0",
    "@fastify/static": "^8.1.0",
    "fastify": "^5.2.0",
    "onnxruntime-node": "^1.31.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
